{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV State (api-and-interface-design)",
  "type": "object",
  "required": ["objective", "upstream_source", "upstream_kind", "mode", "status", "iteration", "max_iterations", "contracts"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["INIT", "PLANNING", "EXECUTING", "VERIFYING", "COMPLETE", "WAITING_FOR_INPUT", "WAITING_FOR_UPSTREAM"]
    },
    "resume_to": {
      "type": "string",
      "description": "仅 status=WAITING_FOR_INPUT 时存在:被阻塞时所处的阶段,用户答复后回到该阶段(由 validate.py 强制)",
      "enum": ["PLANNING", "EXECUTING", "VERIFYING"]
    },
    "mode": {
      "type": "string",
      "description": "INIT 时按用户意图选定,迭代间不变;design=把上游模块设计展开为接口契约,review=对抗评审一份已有接口契约",
      "enum": ["design", "review"]
    },
    "upstream_source": {
      "type": "string",
      "description": "上游产物路径(design:模块设计 .pev/<轮次>/module/output/ 或架构设计 .pev/<轮次>/arch/output/,均为标准上游,两者同在时取粒度更细的 module,或用户提供的文档;review:被评审的已有接口契约文档);引用不复制,溯源与打回都以它为准"
    },
    "upstream_kind": {
      "type": "string",
      "enum": ["module_design", "architecture", "module_doc", "contract_doc"]
    },
    "contracts": {
      "type": "array",
      "description": "INIT 时确认的目标契约面清单(深度与状态逐契约面跟踪);变动须记 DECISION。review 模式置空(评审对象是已有契约文档,不设计契约面)",
      "items": {
        "type": "object",
        "required": ["id", "kind", "depth", "design_status", "review_status"],
        "properties": {
          "id": {"type": "string", "description": "契约面 id,如 C1"},
          "kind": {"type": "string", "enum": ["rest", "graphql", "event", "internal", "frontend_backend"]},
          "depth": {"type": "string", "enum": ["detail", "brief"], "description": "契约深度;变更 = 该契约面设计失效重做"},
          "design_status": {"type": "string", "enum": ["pending", "done"]},
          "review_status": {"type": "string", "enum": ["pending", "pass", "revise"]}
        }
      }
    },
    "cross": {
      "type": "object",
      "description": "Cross 跨契约一致性评审状态;整体 status 停在 VERIFYING 直到 cross.status=passed",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not_started", "passed", "revise_required"]}
      }
    },
    "upstream_gaps": {
      "type": "array",
      "description": "用户选择回上游的缺口清单;仅 status=WAITING_FOR_UPSTREAM 时允许非空(由 validate.py 强制)",
      "items": {
        "type": "object",
        "required": ["what", "upstream_anchor", "blocks"],
        "properties": {
          "what": {"type": "string", "description": "缺口内容:上游未定义/撑不住的边界问题(需新能力/新端点/交互语义缺失)"},
          "upstream_anchor": {"type": "string", "description": "缺口锚定的上游产物位置"},
          "blocks": {"type": "string", "description": "哪些契约面的设计因此无法产出"},
          "why": {"type": "string"}
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string"},
        "deadline": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence Ledger",
      "items": {
        "type": "object",
        "required": ["claim", "type", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN", "DECISION"]},
          "evidence": {"type": ["string", "null"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "source": {
            "type": "object",
            "description": "可选:证据的可定位来源(文件+摘录+摘要)。存在时 validate.py 回读校验新鲜度。path 为项目根目录(含 .pev 的目录)相对路径,或绝对路径",
            "required": ["path", "excerpt"],
            "properties": {
              "path": {"type": "string"},
              "locator": {"type": "string"},
              "excerpt": {"type": "string"},
              "digest": {"type": "string", "description": "sha256:<64位hex> 或 pending"}
            }
          }
        }
      }
    },
    "plans": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 plan 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 artifact 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "default": 5},
    "user_confirmation": {"type": "object", "required": ["date"], "properties": {"date": {"type": "string", "description": "用户确认交付的日期(YYYY-MM-DD)"}, "note": {"type": "string", "description": "确认要点(可选)"}}, "description": "用户对最终交付的确认记录;仅 status=COMPLETE 时允许存在,COMPLETE 必须携带(validate.py 互锁)"}
  }
}
