{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV Plan",
  "type": "object",
  "required": ["goal", "understanding", "known", "unknown", "assumptions", "plan", "final_deliverable", "stop_conditions"],
  "properties": {
    "goal": {"type": "string"},
    "understanding": {"type": "string"},
    "known": {"type": "array", "items": {"type": "string"}},
    "unknown": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "objective", "action", "inputs", "expected_output", "success_criteria"],
        "properties": {
          "id": {"type": "string"},
          "objective": {"type": "string"},
          "action": {
            "type": "string",
            "enum": ["interrogate_value", "interrogate_ambiguity", "draft"],
            "description": "封闭枚举。数组顺序即 R5「价值先行」的判定次序(value → ambiguity → draft)。新增/删除动作必须同步 agents/planner.md 与 scripts/validate.py 的 ACTION_ORDER——校验脚本每次运行都会检查两张表是否一致,不一致即报错"
          },
          "inputs": {"type": "array", "items": {"type": "string"}},
          "expected_output": {"type": "string"},
          "success_criteria": {"type": "string"}
        }
      }
    },
    "final_deliverable": {"type": "string"},
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  }
}
