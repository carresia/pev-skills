{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV Plan (module-design)",
  "type": "object",
  "required": ["goal", "understanding", "known", "unknown", "assumptions", "plan", "final_deliverable", "stop_conditions"],
  "properties": {
    "goal": {"type": "string"},
    "understanding": {"type": "string"},
    "known": {"type": "array", "items": {"type": "string"}},
    "unknown": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "objective", "action", "inputs", "expected_output", "success_criteria"],
        "properties": {
          "id": {"type": "string"},
          "objective": {"type": "string"},
          "action": {
            "type": "string",
            "enum": ["survey_architecture", "survey_codebase", "design_modules", "cross_check", "draft"],
            "description": "封闭枚举;与 agents/planner.md 的输出模板、playbooks/design.md 骨架一致,新增动作需同步改这两处"
          },
          "inputs": {"type": "array", "items": {"type": "string"}},
          "expected_output": {"type": "string"},
          "success_criteria": {"type": "string"}
        }
      }
    },
    "final_deliverable": {"type": "string"},
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  }
}
