{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV State",
  "type": "object",
  "required": ["objective", "arch_source", "mode", "status", "iteration", "max_iterations"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["INIT", "PLANNING", "EXECUTING", "VERIFYING", "COMPLETE", "WAITING_FOR_INPUT", "WAITING_FOR_UPSTREAM"]
    },
    "resume_to": {
      "type": "string",
      "description": "仅 status=WAITING_FOR_INPUT 时存在:被阻塞时所处的阶段,用户答复后回到该阶段并清除(由 validate.py 强制)",
      "enum": ["PLANNING", "EXECUTING", "VERIFYING"]
    },
    "mode": {
      "type": "string",
      "description": "design=拆任务(默认);review=评审已有任务清单(不走 PLANNING/EXECUTING,直接 VERIFYING)",
      "enum": ["design", "review"]
    },
    "arch_source": {
      "type": "string",
      "description": "门槛上游:架构产物路径(.pev/<轮次>/arch/output/)或用户提供的架构文档。架构缺决策时打回 architecture-design,本 skill 不代做架构决定"
    },
    "aux_sources": {
      "type": "array",
      "description": "同轮家族产物自动收纳为补充溯源源(引用不复制):任务的依据不止架构,契约/DDL/Story 都是",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string", "enum": ["module_design", "api_contract", "db_schema", "behavior_catalog", "spec"]},
          "path": {"type": "string"}
        }
      }
    },
    "upstream_gaps": {
      "type": "array",
      "description": "用户选择回上游的缺口清单;仅 status=WAITING_FOR_UPSTREAM 时允许非空(由 validate.py 强制)",
      "items": {
        "type": "object",
        "required": ["what", "upstream_anchor", "blocks"],
        "properties": {
          "what": {"type": "string", "description": "缺口内容:上游未定义/自相矛盾的设计"},
          "upstream_anchor": {"type": "string", "description": "缺口锚定的上游产物与章节/位置,以及该回哪个 skill(architecture-design / module-design / api-and-interface-design / database-schema-design)"},
          "blocks": {"type": "string", "description": "哪些任务因此无法产出"},
          "why": {"type": "string"}
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string"},
        "deadline": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence Ledger",
      "items": {
        "type": "object",
        "required": ["claim", "type", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN", "DECISION"]},
          "evidence": {"type": ["string", "null"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "plans": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 plan 文件名登记册,不存内容副本(validate.py R10 对账)"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 artifact 文件名登记册,不存内容副本(validate.py R10 对账)"},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "default": 5},
    "user_confirmation": {"type": "object", "required": ["date"], "properties": {"date": {"type": "string", "description": "用户确认交付的日期(YYYY-MM-DD)"}, "note": {"type": "string", "description": "确认要点(可选)"}}, "description": "用户对最终交付的确认记录;仅 status=COMPLETE 时允许存在,COMPLETE 必须携带(validate.py 互锁)"}
  }
}
