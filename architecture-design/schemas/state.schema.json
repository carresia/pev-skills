{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV State",
  "type": "object",
  "required": ["objective", "upstream_source", "upstream_kind", "mode", "status", "iteration", "max_iterations"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["INIT", "PLANNING", "EXECUTING", "VERIFYING", "COMPLETE", "WAITING_FOR_INPUT", "WAITING_FOR_UPSTREAM"]
    },
    "resume_to": {
      "type": "string",
      "description": "仅 status=WAITING_FOR_INPUT 时存在:被阻塞时所处的阶段,用户答复后回到该阶段(由 validate.py 强制)",
      "enum": ["PLANNING", "EXECUTING", "VERIFYING"]
    },
    "mode": {
      "type": "string",
      "description": "INIT 时按用户意图选定,迭代间不变;变更须在新迭代 Evidence Ledger 记 DECISION",
      "enum": ["design", "choose", "review"]
    },
    "upstream_source": {
      "type": "string",
      "description": "上游文件路径(优先 .pev/<轮次>/decompose/output/catalog.md,或 rc/output/spec.md、外部 PRD、被评审的设计文档);引用不复制,溯源与打回都以它为准"
    },
    "upstream_kind": {
      "type": "string",
      "enum": ["catalog", "spec", "prd", "design_doc"]
    },
    "upstream_gaps": {
      "type": "array",
      "description": "用户选择回上游的缺口清单;仅 status=WAITING_FOR_UPSTREAM 时允许非空(由 validate.py 强制)",
      "items": {
        "type": "object",
        "required": ["what", "upstream_anchor", "blocks"],
        "properties": {
          "what": {"type": "string", "description": "缺口内容:上游未定义/自相矛盾的产品行为或约束"},
          "upstream_anchor": {"type": "string", "description": "缺口锚定的上游章节/位置"},
          "blocks": {"type": "string", "description": "哪些设计项因此无法产出"},
          "why": {"type": "string"}
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string"},
        "deadline": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence Ledger",
      "items": {
        "type": "object",
        "required": ["claim", "type", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN", "DECISION"]},
          "evidence": {"type": ["string", "null"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "source": {
            "type": "object",
            "description": "可选:证据的可定位来源(文件+摘录+摘要)。存在时 validate.py 回读校验新鲜度。path 为项目根目录(含 .pev 的目录)相对路径,或绝对路径",
            "required": ["path", "excerpt"],
            "properties": {
              "path": {"type": "string"},
              "locator": {"type": "string"},
              "excerpt": {"type": "string"},
              "digest": {"type": "string", "description": "sha256:<64位hex> 或 pending"}
            }
          }
        }
      }
    },
    "plans": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 plan 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 artifact 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "default": 5}
  }
}
