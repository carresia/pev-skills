{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV State (database-schema-design)",
  "type": "object",
  "required": ["objective", "upstream_source", "upstream_kind", "mode", "status", "iteration", "max_iterations", "stores"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["INIT", "PLANNING", "EXECUTING", "VERIFYING", "COMPLETE", "WAITING_FOR_INPUT", "WAITING_FOR_UPSTREAM"]
    },
    "resume_to": {
      "type": "string",
      "description": "仅 status=WAITING_FOR_INPUT 时存在:被阻塞时所处的阶段,用户答复后回到该阶段(由 validate.py 强制)",
      "enum": ["PLANNING", "EXECUTING", "VERIFYING"]
    },
    "mode": {
      "type": "string",
      "description": "INIT 时按用户意图选定,迭代间不变;design=把上游数据声明展开为 schema,review=对抗评审一份已有 schema/DDL",
      "enum": ["design", "review"]
    },
    "upstream_source": {
      "type": "string",
      "description": "上游产物路径(design:模块设计 .pev/<轮次>/module/output/ 或架构设计 .pev/<轮次>/arch/output/,均为标准上游,两者同在时取粒度更细的 module,或用户提供的文档/口述需求锚点;review:被评审的已有 schema/DDL 文档);引用不复制,溯源与打回都以它为准"
    },
    "upstream_kind": {
      "type": "string",
      "enum": ["module_design", "architecture", "module_doc", "schema_request", "schema_doc"]
    },
    "stores": {
      "type": "array",
      "description": "INIT 时确认的目标数据库清单(状态逐库跟踪);变动须记 DECISION。review 模式置空(评审对象是已有 schema 文档,不设计库)",
      "items": {
        "type": "object",
        "required": ["id", "kind", "design_status", "review_status"],
        "properties": {
          "id": {"type": "string", "description": "库 id,如 D1"},
          "kind": {"type": "string", "enum": ["postgresql", "mysql", "mongodb"]},
          "design_status": {"type": "string", "enum": ["pending", "done"]},
          "review_status": {"type": "string", "enum": ["pending", "pass", "revise"]}
        }
      }
    },
    "cross": {
      "type": "object",
      "description": "Cross 跨库一致性评审状态;整体 status 停在 VERIFYING 直到 cross.status=passed",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not_started", "passed", "revise_required"]}
      }
    },
    "upstream_gaps": {
      "type": "array",
      "description": "用户选择回上游的缺口清单;仅 status=WAITING_FOR_UPSTREAM 时允许非空(由 validate.py 强制)",
      "items": {
        "type": "object",
        "required": ["what", "upstream_anchor", "blocks"],
        "properties": {
          "what": {"type": "string", "description": "缺口内容:上游未定义/撑不住的数据边界问题(需存上游外数据/数据所有权冲突/声明语义缺失)"},
          "upstream_anchor": {"type": "string", "description": "缺口锚定的上游产物位置"},
          "blocks": {"type": "string", "description": "哪些库的设计因此无法产出"},
          "why": {"type": "string"}
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string"},
        "deadline": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence Ledger",
      "items": {
        "type": "object",
        "required": ["claim", "type", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN", "DECISION"]},
          "evidence": {"type": ["string", "null"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "source": {
            "type": "object",
            "description": "可选:证据的可定位来源(文件+摘录+摘要)。存在时 validate.py 回读校验新鲜度。path 为项目根目录(含 .pev 的目录)相对路径,或绝对路径",
            "required": ["path", "excerpt"],
            "properties": {
              "path": {"type": "string"},
              "locator": {"type": "string"},
              "excerpt": {"type": "string"},
              "digest": {"type": "string", "description": "sha256:<64位hex> 或 pending"}
            }
          }
        }
      }
    },
    "plans": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 plan 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "description": "iterations/ 下 artifact 文件名登记册,不存内容副本(validate.py R9 对账)"},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "default": 5}
  }
}
