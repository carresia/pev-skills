{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV Artifact",
  "type": "object",
  "required": ["status", "artifact"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "replan_required", "blocked"]},
    "replan_reason": {
      "type": "object",
      "description": "status 为 replan_required / blocked 时必填(由 validate.py 强制)",
      "properties": {
        "problem": {"type": "string"},
        "why_invalid": {"type": "string"},
        "new_information": {"type": "string"},
        "recommended": {"type": "string"}
      }
    },
    "findings": {"type": "array"},
    "problem": {"type": "object"},
    "hypotheses": {"type": "array"},
    "opportunities": {"type": "array"},
    "solutions": {"type": "array"},
    "recommendation": {"type": "object"},
    "roi": {"type": "object"},
    "success_metrics": {"type": "array"},
    "risks": {"type": "array"},
    "artifact": {"type": "object", "description": "面向交付物的正文结构，由 templates/ 渲染"},
    "waived_fields": {
      "type": "array",
      "description": "用户明确豁免的模板必填要素;整字段豁免,同一 field 不得重复(B 类检查与渲染按可选字段为空处理)",
      "items": {
        "type": "object",
        "required": ["field", "reason", "source"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "用户确认日期"}
        }
      }
    }
  }
}
