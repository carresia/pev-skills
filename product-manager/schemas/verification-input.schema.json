{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEV Verification Input Snapshot",
  "description": "iterations/<N>-verification-input.json:派发 Verifier 前的被验证输入快照,由 record_provenance.py 写入",
  "type": "object",
  "required": ["algorithm", "iteration", "plan_path", "artifact_sha256", "plan_sha256", "state_projection_sha256"],
  "properties": {
    "algorithm": {"type": "string", "enum": ["sha256-v1"]},
    "iteration": {"type": "integer", "minimum": 1},
    "plan_path": {"type": "string", "pattern": "^iterations/[0-9]{2,}-plan\\.json$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
